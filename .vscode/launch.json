{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DUTrack Train - Reinject Debug",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/lib/train/run_training.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "CUDA_VISIBLE_DEVICES": "0",
        "PYTORCH_CUDA_ALLOC_CONF": "max_split_size_mb:128"
      },
      "args": [
        "--script", "dutrack",
        "--config", "dutrack_384_lasot_dynamic_token_reinject_debug",
        "--save_dir", "${workspaceFolder}/output",
        "--local_rank", "-1",
        "--use_lmdb", "0",
        "--use_wandb", "0",
        "--seed", "42"
      ]
    },
